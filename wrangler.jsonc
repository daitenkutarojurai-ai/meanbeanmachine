{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bean-machine",
  "main": "apps/server/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "LobbyRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LobbyRoom"] }],
  "observability": { "enabled": true }
}
